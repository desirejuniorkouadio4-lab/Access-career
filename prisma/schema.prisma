generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ══ ENUMS ══
enum Role {
  ADMIN
  INSTRUCTOR
  STUDENT
  MODERATOR
}

enum CourseStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum Category {
  INFORMATIQUE
  IA_DATA
  DEVELOPPEMENT
  COMMUNICATION
  EMPLOYABILITE
  MARKETING
  DESIGN
  LANGUES
}

enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
}

enum SubmissionStatus {
  PENDING
  GRADED
  RETURNED
  LATE
}

enum TopicStatus {
  OPEN
  CLOSED
  PINNED
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

// ══ AUTH ══
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  phone         String?
  role          Role      @default(STUDENT)
  bio           String?
  country       String?
  city          String?
  educationLevel String?
  professionalGoal String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts             Account[]
  sessions             Session[]
  courses              Course[]            @relation("InstructorCourses")
  enrollments          Enrollment[]
  progress             UserProgress[]
  certificates         Certificate[]
  reviews              Review[]
  quizAttempts         QuizAttempt[]
  assignmentSubmissions AssignmentSubmission[]
  forumTopics          ForumTopic[]
  forumReplies         ForumReply[]
  reports              Report[]            @relation("Reporter")
  handledReports       Report[]            @relation("Handler")
  reviewedSubmissions  AssignmentSubmission[] @relation("Reviewer")
  portfolioProjects    PortfolioProject[]
  notes                StudentNote[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

// ══ COURSES ══
model Course {
  id           String       @id @default(cuid())
  title        String
  slug         String       @unique
  description  String?      @db.Text
  objectives   String?      @db.Text
  prerequisites String?     @db.Text
  thumbnail    String?
  price        Float        @default(0)
  isFree       Boolean      @default(false)
  level        Level        @default(BEGINNER)
  category     Category
  status       CourseStatus @default(DRAFT)
  rejectReason String?
  instructorId String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  instructor   User         @relation("InstructorCourses", fields: [instructorId], references: [id])
  chapters     Chapter[]
  enrollments  Enrollment[]
  certificates Certificate[]
  reviews      Review[]
  quizzes      Quiz[]
  assignments  Assignment[]
  forumTopics  ForumTopic[]
  careerPathCourses CareerPathCourse[]
}

model Chapter {
  id       String   @id @default(cuid())
  title    String
  order    Int      @default(0)
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]
}

model Lesson {
  id        String  @id @default(cuid())
  title     String
  content   String? @db.Text
  videoUrl  String?
  documentUrl String?
  duration  Int     @default(0)
  order     Int     @default(0)
  isFree    Boolean @default(false)
  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  progress  UserProgress[]
  quiz      Quiz?
  assignment Assignment?
  notes     StudentNote[]
}

// ══ ENROLLMENT & PROGRESS ══
model Enrollment {
  id           String    @id @default(cuid())
  userId       String
  courseId      String
  progress     Float     @default(0)
  lastAccessedAt DateTime?
  enrolledAt   DateTime  @default(now())
  completedAt  DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@unique([userId, courseId])
}

model UserProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  isCompleted Boolean   @default(false)
  timeSpent   Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  @@unique([userId, lessonId])
}

model StudentNote {
  id       String @id @default(cuid())
  userId   String
  lessonId String
  content  String @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  @@unique([userId, lessonId])
}

// ══ QUIZ & EVALUATION ══
model Quiz {
  id           String   @id @default(cuid())
  title        String
  description  String?
  courseId      String
  lessonId     String?  @unique
  passingScore Int      @default(70)
  maxAttempts  Int      @default(3)
  durationMinutes Int?
  showCorrection Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  course    Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson    Lesson?      @relation(fields: [lessonId], references: [id])
  questions QuizQuestion[]
  attempts  QuizAttempt[]
}

model QuizQuestion {
  id             String       @id @default(cuid())
  quizId         String
  type           QuestionType @default(SINGLE_CHOICE)
  question       String       @db.Text
  options        Json
  correctAnswers Json
  points         Int          @default(1)
  explanation    String?      @db.Text
  order          Int          @default(0)

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id            String   @id @default(cuid())
  quizId        String
  userId        String
  score         Float    @default(0)
  maxScore      Float    @default(0)
  passed        Boolean  @default(false)
  attemptNumber Int      @default(1)
  answers       Json
  startedAt     DateTime @default(now())
  submittedAt   DateTime?

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ══ ASSIGNMENTS ══
model Assignment {
  id              String   @id @default(cuid())
  title           String
  instructions    String?  @db.Text
  courseId         String
  lessonId        String?  @unique
  maxScore        Int      @default(100)
  dueDate         DateTime?
  allowedFileTypes String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  course      Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson      Lesson?                @relation(fields: [lessonId], references: [id])
  submissions AssignmentSubmission[]
}

model AssignmentSubmission {
  id           String           @id @default(cuid())
  assignmentId String
  userId       String
  textAnswer   String?          @db.Text
  fileUrl      String?
  externalLink String?
  status       SubmissionStatus @default(PENDING)
  score        Int?
  feedback     String?          @db.Text
  reviewedById String?
  submittedAt  DateTime         @default(now())
  reviewedAt   DateTime?

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User?      @relation("Reviewer", fields: [reviewedById], references: [id])
}

// ══ CERTIFICATES ══
model Certificate {
  id       String   @id @default(cuid())
  userId   String
  courseId  String
  certCode String   @unique @default(cuid())
  pdfUrl   String?
  issuedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@unique([userId, courseId])
}

// ══ REVIEWS ══
model Review {
  id        String   @id @default(cuid())
  userId    String
  courseId   String
  rating    Int
  comment   String?  @db.Text
  status    String   @default("PUBLISHED")
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@unique([userId, courseId])
}

// ══ FORUMS ══
model ForumTopic {
  id        String      @id @default(cuid())
  courseId   String
  userId    String
  title     String
  content   String      @db.Text
  status    TopicStatus @default(OPEN)
  pinned    Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  course  Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies ForumReply[]
}

model ForumReply {
  id              String   @id @default(cuid())
  topicId         String
  userId          String
  content         String   @db.Text
  isOfficialAnswer Boolean @default(false)
  helpfulCount    Int      @default(0)
  status          String   @default("VISIBLE")
  createdAt       DateTime @default(now())

  topic ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ══ REPORTS ══
model Report {
  id         String       @id @default(cuid())
  reporterId String
  targetType String
  targetId   String
  reason     String       @db.Text
  status     ReportStatus @default(PENDING)
  handledById String?
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  reporter  User  @relation("Reporter", fields: [reporterId], references: [id])
  handledBy User? @relation("Handler", fields: [handledById], references: [id])
}

// ══ CAREER PATHS ══
model CareerPath {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  description      String?  @db.Text
  professionalGoal String?
  level            Level    @default(BEGINNER)
  duration         String?
  coverImage       String?
  status           String   @default("DRAFT")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  courses CareerPathCourse[]
}

model CareerPathCourse {
  id           String @id @default(cuid())
  careerPathId String
  courseId      String
  sortOrder    Int    @default(0)

  careerPath CareerPath @relation(fields: [careerPathId], references: [id], onDelete: Cascade)
  course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@unique([careerPathId, courseId])
}

// ══ PORTFOLIO ══
model PortfolioProject {
  id           String   @id @default(cuid())
  userId       String
  courseId      String?
  title        String
  description  String?  @db.Text
  fileUrl      String?
  externalLink String?
  status       String   @default("DRAFT")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
